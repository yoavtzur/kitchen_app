# Copy this file to .env.local (already gitignored) and fill in your Supabase project's values,
# found in the Supabase dashboard under Project Settings → API.
#
# Leave .env.local absent (or these two vars unset) to run the app in local-only mode — no
# account, no restaurant, everything in this browser's localStorage, exactly like before sync
# was added. That's a fully supported mode, not just a fallback for missing setup.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
